{
  "name": "comike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.21.0 || ^24.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n client,server \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint -w client",
    "test": "npm run test -w server",
    "start": "npm run start -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:studio": "npm run db:studio -w server",
    "db:init": "npm run db:init -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "~6.0.0"
  }
}
