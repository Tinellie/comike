COMIKE_IMAGE=ghcr.io/tinellie/comike:latest
# On this server deploy is UID/GID 1001. Confirm with: id -u; id -g
APP_UID=1001
APP_GID=1001
# Generate each password separately: openssl rand -hex 32
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
# Server-only Pixiv App API OAuth credentials. PHPSESSID is not used.
PIXIV_ACCESS_TOKEN=
# All three are required for automatic refresh.
PIXIV_REFRESH_TOKEN=
PIXIV_CLIENT_ID=
PIXIV_CLIENT_SECRET=
# Optional HTTP/HTTPS proxy reachable from the app container; leave empty for direct access.
PIXIV_PROXY_URL=
