PORT=3001
# Paths are relative to the project root. State must not be publicly served.
MEDIA_ROOT=storage
CRAWLER_STATE_DIR=.local/crawler
# Pixiv App API: server-only OAuth credentials, not browser cookies.
# Access-token-only mode requires manually replacing expired tokens.
PIXIV_ACCESS_TOKEN=
# Automatic refresh requires all three values from the same authorized OAuth client.
PIXIV_REFRESH_TOKEN=
PIXIV_CLIENT_ID=
PIXIV_CLIENT_SECRET=
# Optional HTTP/HTTPS proxy used only for Pixiv API and image requests.
# Local example: http://127.0.0.1:7890 (inside Docker, localhost is the container).
PIXIV_PROXY_URL=
# Set this to your public HTTPS origin behind a reverse proxy.
HALL_EDITOR_ORIGIN=http://localhost:5173
# Set true when serving HTTPS (also enabled automatically by NODE_ENV=production).
AUTH_COOKIE_SECURE=false
# Trust exactly one proxy hop, only when direct access to the app is blocked.
TRUST_PROXY=false
# Docker's lightweight image disables only server-side PDF OCR; local development keeps it enabled.
OCR_ENABLED=true
# Required for registration, login and booth data. Run npm run db:init first.
# URL-encode special characters in the username and password.
DATABASE_URL=mysql://comike:CHANGE_ME@127.0.0.1:3306/comike
