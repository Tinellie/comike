{
  "name": "@comike/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:init": "tsx --env-file-if-exists=.env src/db/init.ts",
    "auth:admin": "tsx --env-file-if-exists=.env src/auth/admin.ts",
    "db:readings": "tsx --env-file-if-exists=.env src/booths/backfill.ts",
    "db:map-vacancies": "tsx --env-file-if-exists=.env src/booths/reconcileCli.ts",
    "db:map-genres": "tsx --env-file-if-exists=.env src/booths/reconcileCli.ts --genres"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "crawlee": "^3.15.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "kuromoji": "^0.1.2",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/kuromoji": "^0.1.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0"
  }
}
